# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM to use: asi1 | gemini | anthropic
LLM_PROVIDER=asi1

# LLM keys (only the one for your LLM_PROVIDER is needed)
ASI1_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fetch.ai agent seed phrases (any long random sentence; keep them stable so addresses never change)
CHAIR_SEED=
REFEREE_SEED=
MACRO_SEED=
FUNDAMENTALS_SEED=
RISK_SEED=

# Agent addresses (filled in after run_all.py prints them)
CHAIR_ADDRESS=
REFEREE_ADDRESS=
MACRO_ADDRESS=
FUNDAMENTALS_ADDRESS=
RISK_ADDRESS=
